// Multiempresa / Multisucursal / Suscripciones SaaS

/// Ver modules/electronic-invoicing/README.md, seccion "Proveedor tecnologico (MATIAS API)".
/// DIRECT = envio directo a la DIAN existente (dian-soap-client.ts, default, sin cambios de
/// conducta). MATIAS = via proveedor tecnologico (matias-invoicing-client.ts), solo facturas de
/// venta por ahora (ver README). Un solo proveedor real implementado; no se modela como tabla
/// generica "por si acaso" se suma Plemsi despues -- se decide si vale la pena esa
/// generalizacion cuando exista una segunda implementacion real que comparar.
enum DianProviderType {
  DIRECT
  MATIAS
}

model Company {
  id        String   @id @default(uuid())
  name      String
  legalName String
  nit       String   @unique
  email     String
  phone     String?
  logoUrl   String?
  timezone  String   @default("America/Bogota")
  currency  String   @default("COP")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Preparado para nomina electronica DIAN (ver electronic-invoicing.prisma). municipalityCode
  // SIN VERIFICAR: simplificacion de "una sola sede" para todos los empleados, ver README.
  municipalityCode          String? // codigo DANE del lugar de trabajo por defecto
  payrollElectronicSequence Int     @default(0)
  payrollElectronicPrefix   String?
  // ---- Proveedor tecnologico DIAN (ver modules/electronic-invoicing/README.md) ----
  // matiasApiTokenEncrypted: el PAT de MATIAS de ESTA empresa, cifrado (credential-cipher.ts) --
  // nunca en texto plano en la base ni en env, porque cada empresa cliente de Contapro tiene su
  // propia cuenta/NIT en MATIAS. Cargado una sola vez via PUT
  // /electronic-invoicing/provider-settings; no se puede volver a leer en texto plano despues.
  electronicInvoicingProvider DianProviderType @default(DIRECT)
  matiasApiTokenEncrypted     String?

  // ---- Datos fiscales DIAN de la empresa (ver modules/company/README.md) ----
  // Strings planos opcionales SIN catalogo/enum, mismo criterio ya usado en Customer.dian* --
  // este codebase deliberadamente no inventa catalogos DIAN sin verificar contra la fuente real.
  // NO se envian a MATIAS: su payload por factura no tiene objeto seller/emisor, la identidad del
  // emisor vive en la cuenta/token de MATIAS (ver matias-invoicing-client.ts). Sirven para (1) el
  // gate de completitud antes de la primera factura manual (modules/manual-invoicing), (2) futuro
  // enriquecimiento del XML UBL del camino DIRECT, (3) datos de cumplimiento/visualizacion.
  documentType           String? // "NIT" | "CC", igual que Customer.documentType
  dv                     String? // digito de verificacion
  taxRegime              String? // regimen tributario
  fiscalResponsibilities String? // responsabilidad tributaria
  address                String?
  municipality            String? // nombre, complementa municipalityCode (codigo DANE) de arriba
  department              String?

  branches      Branch[]
  users         User[]
  roles         Role[]
  subscriptions Subscription[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  code      String
  address   String?
  phone     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userBranches UserBranch[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model Plan {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  priceMonthly Decimal  @db.Decimal(12, 2)
  priceYearly  Decimal  @db.Decimal(12, 2)
  maxBranches  Int
  maxUsers     Int
  features     Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

model Subscription {
  id               String             @id @default(uuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id])
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(TRIALING)
  billingCycle      String            @default("MONTHLY") // MONTHLY, YEARLY
  startDate        DateTime
  currentPeriodEnd DateTime
  // graceEndsAt = currentPeriodEnd + 2 dias exactos (calculado por la app, no aqui)
  graceEndsAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // ---- Cobro recurrente automatico via Wompi (ver RunSubscriptionAutoChargesUseCase) ----
  // true solo despues de que el cliente tokeniza su tarjeta y consiente guardarla
  // (SavePaymentSourceUseCase); false = el flujo sigue siendo el link de pago manual de siempre.
  autoRenew            Boolean @default(false)
  // Id de la "fuente de pago" (payment_source) que Wompi devuelve al guardar la tarjeta -- se usa
  // para cobrar sin que el cliente este presente (POST /transactions con payment_source_id, sin
  // redireccion). Nunca se guarda el numero de tarjeta ni el token de un solo uso, solo esta
  // referencia reutilizable.
  wompiPaymentSourceId String?
  // Solo para mostrarle al usuario que tarjeta tiene guardada (ej. "Visa terminada en 4242") --
  // dato publico que Wompi devuelve junto con el payment_source, no PCI-sensible.
  cardLastFour         String?
  cardBrand            String?

  payments  SubscriptionPayment[]
  reminders SubscriptionReminderLog[]

  @@index([companyId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  amount         Decimal      @db.Decimal(12, 2)
  method         String
  reference      String?
  status         String       @default("PENDING") // PENDING, CONFIRMED, FAILED
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
  @@map("subscription_payments")
}

model SubscriptionReminderLog {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  daysBeforeDue  Int          // 8, 5, 3, 1, 0
  sentAt         DateTime     @default(now())
  channel        String       // EMAIL, IN_APP, WHATSAPP

  @@unique([subscriptionId, daysBeforeDue])
  @@map("subscription_reminder_logs")
}

/// Operador de la plataforma (no pertenece a ninguna Company) -- autenticacion completamente
/// separada de User (ver modules/saas-admin/README.md): JWT propio (JWT_PLATFORM_ADMIN_SECRET),
/// sin AsyncLocalStorage/tenant context, repos via basePrisma. Sin relacion a Company/Role/User.
model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("platform_admins")
}
