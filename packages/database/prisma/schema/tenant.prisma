// Multiempresa / Multisucursal / Suscripciones SaaS

model Company {
  id        String   @id @default(uuid())
  name      String
  legalName String
  nit       String   @unique
  email     String
  phone     String?
  logoUrl   String?
  timezone  String   @default("America/Bogota")
  currency  String   @default("COP")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Preparado para nomina electronica DIAN (ver electronic-invoicing.prisma). municipalityCode
  // SIN VERIFICAR: simplificacion de "una sola sede" para todos los empleados, ver README.
  municipalityCode          String? // codigo DANE del lugar de trabajo por defecto
  payrollElectronicSequence Int     @default(0)
  payrollElectronicPrefix   String?

  branches      Branch[]
  users         User[]
  roles         Role[]
  subscriptions Subscription[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  code      String
  address   String?
  phone     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userBranches UserBranch[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model Plan {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  priceMonthly Decimal  @db.Decimal(12, 2)
  priceYearly  Decimal  @db.Decimal(12, 2)
  maxBranches  Int
  maxUsers     Int
  features     Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

model Subscription {
  id               String             @id @default(uuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id])
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(TRIALING)
  billingCycle      String            @default("MONTHLY") // MONTHLY, YEARLY
  startDate        DateTime
  currentPeriodEnd DateTime
  // graceEndsAt = currentPeriodEnd + 2 dias exactos (calculado por la app, no aqui)
  graceEndsAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments  SubscriptionPayment[]
  reminders SubscriptionReminderLog[]

  @@index([companyId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  amount         Decimal      @db.Decimal(12, 2)
  method         String
  reference      String?
  status         String       @default("PENDING") // PENDING, CONFIRMED, FAILED
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
  @@map("subscription_payments")
}

model SubscriptionReminderLog {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  daysBeforeDue  Int          // 8, 5, 3, 1, 0
  sentAt         DateTime     @default(now())
  channel        String       // EMAIL, IN_APP, WHATSAPP

  @@unique([subscriptionId, daysBeforeDue])
  @@map("subscription_reminder_logs")
}

/// Operador de la plataforma (no pertenece a ninguna Company) -- autenticacion completamente
/// separada de User (ver modules/saas-admin/README.md): JWT propio (JWT_PLATFORM_ADMIN_SECRET),
/// sin AsyncLocalStorage/tenant context, repos via basePrisma. Sin relacion a Company/Role/User.
model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("platform_admins")
}
