// Facturacion electronica DIAN (Colombia) — ver apps/api/src/modules/electronic-invoicing/README.md
// Genera CUFE/CUDE + XML localmente siempre (facturas, notas credito, notas debito). Si hay
// certificado configurado (DIAN_CERTIFICATE_PATH), tambien firma XAdES y encola el envio SOAP a
// la DIAN -- sin verificar contra la DIAN real todavia (sin credenciales de habilitacion reales
// aun), ver README del modulo.

enum DianDocumentType {
  FACTURA_VENTA
  NOTA_CREDITO
  NOTA_DEBITO
  DOCUMENTO_SOPORTE
}

enum ElectronicInvoiceStatus {
  GENERATED // CUFE/CUDE + XML generados localmente
  PENDING_SIGNATURE // reservado: firma XAdES pendiente (la firma es sincrona, no se usa hoy)
  PENDING_SUBMISSION // firmado, encolado/enviado, esperando respuesta de la DIAN
  ACCEPTED // la DIAN acepto el documento
  REJECTED // la DIAN rechazo el documento
}

/// Rango de numeracion autorizado por la DIAN ("resolucion de facturacion"), independiente
/// del consecutivo interno Sale.number (ticket POS por sucursal, no debe tocarse). Una empresa
/// puede tener una resolucion vigente por cada documentType (factura, nota credito, nota debito
/// tienen resoluciones DIAN separadas en la vida real).
model InvoiceNumberingResolution {
  id               String           @id @default(uuid())
  companyId        String
  branchId         String? // null = aplica a todas las sucursales de la empresa
  documentType     DianDocumentType @default(FACTURA_VENTA)
  resolutionNumber String // numero de resolucion otorgado por la DIAN (dato administrativo)
  prefix           String // ej. "SETP"
  rangeFrom        Int
  rangeTo          Int
  currentNumber    Int      @default(0) // ultimo numero entregado; 0 = ninguno entregado aun
  validFrom        DateTime
  validUntil       DateTime
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  invoices         ElectronicInvoice[]
  creditNotes      ElectronicCreditNote[]
  debitNotes       ElectronicDebitNote[]
  supportDocuments ElectronicSupportDocument[]

  @@unique([companyId, documentType, prefix])
  @@index([companyId, branchId, documentType, isActive])
  @@map("invoice_numbering_resolutions")
}

/// Un registro por venta facturada electronicamente. El XML completo se guarda en xmlContent
/// (sin storage de objetos configurado aun, ver README del modulo).
model ElectronicInvoice {
  id                     String                  @id @default(uuid())
  companyId              String
  branchId               String
  saleId                 String                  @unique
  sale                   Sale                    @relation(fields: [saleId], references: [id])
  numberingResolutionId  String
  numberingResolution    InvoiceNumberingResolution @relation(fields: [numberingResolutionId], references: [id])
  prefix                 String
  number                 Int
  fullNumber             String // prefix + number, ej "SETP990000001"
  cufe                   String
  issueDate              DateTime
  customerDocumentType   String
  customerDocumentNumber String
  customerName           String
  subtotal               Decimal                 @db.Decimal(14, 2)
  taxTotal               Decimal                 @db.Decimal(14, 2)
  total                  Decimal                 @db.Decimal(14, 2)
  environment            String // snapshot de DIAN_ENVIRONMENT al generar (HABILITACION|PRODUCCION)
  xmlContent              String                  @db.Text
  status                 ElectronicInvoiceStatus      @default(GENERATED)
  createdAt              DateTime                @default(now())

  // ---- Firma XAdES + envio DIAN (ver README: no verificado contra la DIAN real todavia) ----
  signedXmlContent String?   @db.Text
  dianTrackingId   String?
  dianResponseXml  String?   @db.Text
  rejectionReason  String?
  submittedAt      DateTime?
  respondedAt      DateTime?

  @@unique([companyId, prefix, number])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, status])
  @@map("electronic_invoices")
}

/// Un registro por nota credito facturada electronicamente. referenceCufe es el CUFE de la
/// factura original que la nota afecta (obtenido de ElectronicInvoice.cufe via CreditNote.saleId
/// -- si la venta referenciada no tiene factura electronica todavia, no se genera CUDE).
model ElectronicCreditNote {
  id                     String                  @id @default(uuid())
  companyId              String
  branchId               String
  creditNoteId           String                  @unique
  creditNote             CreditNote              @relation(fields: [creditNoteId], references: [id])
  numberingResolutionId  String
  numberingResolution    InvoiceNumberingResolution @relation(fields: [numberingResolutionId], references: [id])
  prefix                 String
  number                 Int
  fullNumber             String
  cude                   String
  referenceCufe          String // CUFE de la factura original referenciada
  issueDate              DateTime
  customerDocumentType   String
  customerDocumentNumber String
  customerName           String
  amount                 Decimal                 @db.Decimal(14, 2)
  environment            String
  xmlContent             String                  @db.Text
  status                 ElectronicInvoiceStatus      @default(GENERATED)
  createdAt              DateTime                @default(now())

  signedXmlContent String?   @db.Text
  dianTrackingId   String?
  dianResponseXml  String?   @db.Text
  rejectionReason  String?
  submittedAt      DateTime?
  respondedAt      DateTime?

  @@unique([companyId, prefix, number])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, status])
  @@map("electronic_credit_notes")
}

/// Analogo a ElectronicCreditNote para notas debito.
model ElectronicDebitNote {
  id                     String                  @id @default(uuid())
  companyId              String
  branchId               String
  debitNoteId            String                  @unique
  debitNote              DebitNote               @relation(fields: [debitNoteId], references: [id])
  numberingResolutionId  String
  numberingResolution    InvoiceNumberingResolution @relation(fields: [numberingResolutionId], references: [id])
  prefix                 String
  number                 Int
  fullNumber             String
  cude                   String
  referenceCufe          String
  issueDate              DateTime
  customerDocumentType   String
  customerDocumentNumber String
  customerName           String
  amount                 Decimal                 @db.Decimal(14, 2)
  environment            String
  xmlContent             String                  @db.Text
  status                 ElectronicInvoiceStatus      @default(GENERATED)
  createdAt              DateTime                @default(now())

  signedXmlContent String?   @db.Text
  dianTrackingId   String?
  dianResponseXml  String?   @db.Text
  rejectionReason  String?
  submittedAt      DateTime?
  respondedAt      DateTime?

  @@unique([companyId, prefix, number])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, status])
  @@map("electronic_debit_notes")
}

/// Documento soporte electronico: lo genera la propia empresa (como comprador) cuando compra a
/// un Supplier con isObligatedToInvoice=false (persona natural/vendedor informal que no puede
/// expedir su propia factura electronica). A diferencia de las notas, no referencia ningun otro
/// documento -- es el documento original de esa compra. ADVERTENCIA: el esquema XML de este tipo
/// de documento es la parte MENOS verificada de todo el modulo (ver README y el aviso de
/// cabecera en application/ubl-support-document-xml-builder.ts).
model ElectronicSupportDocument {
  id                     String                  @id @default(uuid())
  companyId              String
  branchId               String
  purchaseId             String                  @unique
  purchase               Purchase                @relation(fields: [purchaseId], references: [id])
  numberingResolutionId  String
  numberingResolution    InvoiceNumberingResolution @relation(fields: [numberingResolutionId], references: [id])
  prefix                 String
  number                 Int
  fullNumber             String
  cuds                   String
  issueDate              DateTime
  supplierDocumentType   String
  supplierDocumentNumber String
  supplierName           String
  subtotal               Decimal                 @db.Decimal(14, 2)
  taxTotal               Decimal                 @db.Decimal(14, 2)
  total                  Decimal                 @db.Decimal(14, 2)
  environment            String
  xmlContent             String                  @db.Text
  status                 ElectronicInvoiceStatus @default(GENERATED)
  createdAt              DateTime                @default(now())

  signedXmlContent String?   @db.Text
  dianTrackingId   String?
  dianResponseXml  String?   @db.Text
  rejectionReason  String?
  submittedAt      DateTime?
  respondedAt      DateTime?

  @@unique([companyId, prefix, number])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, status])
  @@map("electronic_support_documents")
}

/// Nomina electronica DIAN (Resolucion 000013 de 2021) -- ESTRUCTURALMENTE DISTINTA a los otros
/// 4 tipos de documento de este archivo: esquema XML propio (no UBL), codigo unico CUNE (no
/// CUFE/CUDE/CUDS), servicio SOAP DIAN separado (ver dian-nomina-soap-client.ts). La DIAN genera
/// un documento POR EMPLEADO POR PERIODO, por eso esta enlazado a PayrollDetail (no a Payroll).
/// Sin InvoiceNumberingResolution: la nomina electronica no usa rango autorizado por la DIAN
/// (entendimiento general, SIN VERIFICAR) -- el numero sale de Company.payrollElectronicSequence,
/// un contador atomico simple. ESTA ES LA PARTE MAS ESPECULATIVA DE TODO EL MODULO -- ver README.
model ElectronicPayroll {
  id              String                  @id @default(uuid())
  companyId       String
  branchId        String
  payrollDetailId String                  @unique
  payrollDetail   PayrollDetail           @relation(fields: [payrollDetailId], references: [id])
  prefix          String?
  number          Int
  fullNumber      String
  cune            String
  issueDate       DateTime
  employeeDocumentType   String
  employeeDocumentNumber String
  employeeName           String
  grossTotal      Decimal                 @db.Decimal(14, 2)
  totalDeductions Decimal                 @db.Decimal(14, 2)
  netPay          Decimal                 @db.Decimal(14, 2)
  environment     String
  xmlContent      String                  @db.Text
  status          ElectronicInvoiceStatus @default(GENERATED)
  createdAt       DateTime                @default(now())

  signedXmlContent String?   @db.Text
  dianTrackingId   String?
  dianResponseXml  String?   @db.Text
  rejectionReason  String?
  submittedAt      DateTime?
  respondedAt      DateTime?

  @@unique([companyId, fullNumber])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, status])
  @@map("electronic_payrolls")
}
