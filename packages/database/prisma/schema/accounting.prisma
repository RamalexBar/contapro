// Contabilidad (STUB en la iteracion 1: modelo completo, sin logica de negocio todavia)
// Ver apps/api/src/modules/accounting/README.md

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum WithholdingType {
  RETEFUENTE
  RETEICA
  RETEIVA
}

// Conceptos de retencion configurables por empresa (ver post-sale-journal-entry.use-case.ts y
// post-purchase-journal-entry.use-case.ts): cada uno agrega en una de 6 cuentas fijas por tipo
// (una por tipo x direccion venta/compra), nunca una cuenta por concepto -- mismo criterio que ya
// usa 2408 para IVA sin importar la tarifa del producto. Tarifa (ratePercent) se snapshotea en
// SaleWithholding/PurchaseWithholding al aplicarse, para que editar el concepto despues no altere
// ventas/compras ya registradas.
model WithholdingConcept {
  id          String          @id @default(uuid())
  companyId   String
  code        String
  name        String
  type        WithholdingType
  ratePercent Decimal         @db.Decimal(5, 2)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  // Item 37 de docs/ALCANCE.md (informacion exogena DIAN, formato 1003): codigo numerico DIAN de
  // concepto de retencion (ej. 1301 compras, 1302 servicios) -- distinto de `code`, que es libre
  // por empresa. Nullable: sin asignar, el reporte marca las filas de este concepto como
  // "conceptoIncompleto" en vez de fallar.
  dianConceptCode String?

  saleWithholdings     SaleWithholding[]
  purchaseWithholdings PurchaseWithholding[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("withholding_concepts")
}

// Centros de costo (item 34 de docs/ALCANCE.md): catalogo simple para segmentar comprobantes por
// area/proyecto -- mismo criterio que WithholdingConcept arriba. A diferencia de `branchId` en
// JournalEntry (presente en el schema desde la iteracion 1 pero nunca leido por ningun reporte,
// mismo patron de columna muerta que Company.currency en el item 33), este campo SI se filtra en
// AccountingReportsService.getIncomeStatement/getLedger -- ver ese archivo.
model CostCenter {
  id        String   @id @default(uuid())
  companyId String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, code])
  @@index([companyId])
  @@map("cost_centers")
}

model ChartOfAccounts {
  id             String            @id @default(uuid())
  companyId      String
  code           String
  name           String
  type           AccountType
  parentId       String?
  parent         ChartOfAccounts?  @relation("AccountTree", fields: [parentId], references: [id])
  children       ChartOfAccounts[] @relation("AccountTree")
  level          Int
  isActive       Boolean           @default(true)
  acceptsEntries Boolean           @default(true)

  @@unique([companyId, code])
  @@index([companyId])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id              String    @id @default(uuid())
  companyId       String
  branchId        String?
  // Item 34: etiquetado opcional, hoy solo via comprobante manual o gasto operativo (ver
  // create-journal-entry.use-case.ts / post-expense-journal-entry.use-case.ts). Sin relacion de
  // Prisma declarada ni FK -- mismo criterio que accountId/branchId en este mismo modelo.
  costCenterId    String?
  number          Int
  date            DateTime
  description     String
  type            String    // MANUAL, SALE, RETURN, PURCHASE, PAYROLL, ADJUSTMENT
  sourceType      String?
  sourceId        String?
  status          String    @default("DRAFT") // DRAFT, POSTED, VOID
  createdByUserId String
  postedAt        DateTime?
  createdAt       DateTime  @default(now())

  lines JournalEntryLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  accountId      String
  debit          Decimal      @db.Decimal(14, 2) @default(0)
  credit         Decimal      @db.Decimal(14, 2) @default(0)
  description    String?
  thirdPartyType String?
  thirdPartyId   String?

  @@map("journal_entry_lines")
}

model FinancialPeriod {
  id        String    @id @default(uuid())
  companyId String
  year      Int
  month     Int
  status    String    @default("OPEN") // OPEN, CLOSED
  closedAt  DateTime?

  @@unique([companyId, year, month])
  @@map("financial_periods")
}

model BankAccount {
  id             String   @id @default(uuid())
  companyId      String
  bankName       String
  accountNumber  String
  accountType    String
  currentBalance Decimal  @db.Decimal(14, 2) @default(0)

  transactions    BankTransaction[]
  reconciliations BankReconciliation[]

  @@index([companyId])
  @@map("bank_accounts")
}

model BankTransaction {
  id            String      @id @default(uuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  date          DateTime
  description   String
  amount        Decimal     @db.Decimal(14, 2)
  type          String      // DEBIT, CREDIT
  reconciled    Boolean     @default(false)

  @@index([bankAccountId])
  @@map("bank_transactions")
}

model BankReconciliation {
  id               String      @id @default(uuid())
  bankAccountId    String
  bankAccount      BankAccount @relation(fields: [bankAccountId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  statementBalance Decimal     @db.Decimal(14, 2)
  bookBalance      Decimal     @db.Decimal(14, 2)
  status           String      @default("IN_PROGRESS")
  createdAt        DateTime    @default(now())

  items BankReconciliationItem[]

  @@map("bank_reconciliations")
}

model BankReconciliationItem {
  id                 String             @id @default(uuid())
  reconciliationId   String
  reconciliation     BankReconciliation @relation(fields: [reconciliationId], references: [id])
  bankTransactionId  String?
  journalEntryLineId String?
  matched            Boolean            @default(false)

  @@map("bank_reconciliation_items")
}
