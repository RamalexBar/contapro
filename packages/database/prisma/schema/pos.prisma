// Facturacion POS: ventas, cotizaciones, pedidos, devoluciones, notas, apartados

enum SaleStatus {
  DRAFT
  PENDING_AUTHORIZATION
  COMPLETED
  CANCELLED
  RETURNED_PARTIAL
  RETURNED_FULL
}

enum PaymentStatus {
  PAID
  PARTIAL
  CREDIT
  PENDING
}

model Sale {
  id            String        @id @default(uuid())
  companyId     String
  branchId      String
  number        Int           // consecutivo por sucursal (generado en use-case con transaccion)
  customerId    String?
  cashSessionId String?
  sellerUserId  String
  status        SaleStatus    @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)
  type          String        @default("POS") // POS, CREDIT
  subtotal      Decimal       @db.Decimal(14, 2)
  discountTotal Decimal       @db.Decimal(14, 2) @default(0)
  taxTotal      Decimal       @db.Decimal(14, 2) @default(0)
  total         Decimal       @db.Decimal(14, 2)
  // Multi-moneda informativa (item 33 de docs/ALCANCE.md): el comprobante contable
  // (post-sale-journal-entry.use-case.ts) y el XML DIAN (ubl-invoice-xml-builder.ts) siempre
  // quedan en COP sin importar estos dos campos -- son solo para mostrar un total de referencia
  // en otra moneda. `exchangeRate` es la TRM capturada manualmente al momento de la venta (COP
  // por 1 unidad de `currency`), sin fetch automatico en esta primera version.
  currency      String        @default("COP") // ISO 4217, 3 letras
  exchangeRate  Decimal       @db.Decimal(14, 4) @default(1)
  // Lista de precios efectiva usada al vender (item 35 de docs/ALCANCE.md) -- informativa, para
  // trazabilidad; el precio real ya quedo fijado en SaleItem.unitPrice. Null = precio base.
  priceListId   String?
  // Suma de retenciones practicadas por el cliente (RteFuente/ReteICA/ReteIVA, ver
  // SaleWithholding) -- informativa, no reduce `total` (el bruto legal de la factura), solo el
  // efectivo realmente cobrado (netTotal = total - retentionTotal en create-sale.use-case.ts).
  retentionTotal Decimal      @db.Decimal(14, 2) @default(0)
  // Preparado para facturacion electronica futura (DIAN):
  cufe          String?
  cude          String?
  invoiceXmlUrl String?
  cancelReason  String?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())

  items             SaleItem[]
  payments          SalePayment[]
  withholdings       SaleWithholding[]
  electronicInvoice ElectronicInvoice?
  // Presente solo si la venta incluyo un pago method="CREDIT" -- ver
  // apps/api/src/modules/collections/README.md (item 31 de docs/ALCANCE.md).
  accountReceivable AccountReceivable?
  // Presente solo si esta venta se origino al cerrar una Opportunity como ganada -- ver
  // apps/api/src/modules/crm/opportunity/README.md (item 32 de docs/ALCANCE.md).
  opportunity       Opportunity?

  @@unique([branchId, number])
  @@index([companyId, branchId, createdAt])
  @@map("sales")
}

/**
 * Consecutivo real por sucursal para Sale.number -- reemplaza el `count()+1` original (que bajo
 * varios cajeros vendiendo al mismo tiempo en la misma sucursal chocaba contra
 * `Sale.@@unique([branchId, number])` con un 500, verificado en vivo con 8 ventas disparadas en
 * paralelo). Se incrementa con un UPDATE atomico (`lastNumber: { increment: 1 }`) dentro de la
 * misma transaccion de la venta -- Postgres serializa updates concurrentes sobre la misma fila
 * via lock de fila, asi que dos transacciones nunca pueden leer el mismo valor. Ver
 * PrismaSaleRepository.getNextSaleNumber().
 */
model BranchSaleCounter {
  id         String @id @default(uuid())
  companyId  String
  branchId   String
  lastNumber Int    @default(0)

  @@unique([companyId, branchId])
  @@map("branch_sale_counters")
}

model SaleItem {
  id                            String  @id @default(uuid())
  saleId                        String
  sale                          Sale    @relation(fields: [saleId], references: [id])
  productId                     String
  presentationId                String?
  batchId                       String?
  quantity                      Decimal @db.Decimal(14, 4)
  unitPrice                     Decimal @db.Decimal(14, 4)
  discountPercent               Decimal @db.Decimal(5, 2) @default(0)
  discountAmount                Decimal @db.Decimal(14, 2) @default(0)
  taxPercent                    Decimal @db.Decimal(5, 2)
  taxAmount                     Decimal @db.Decimal(14, 2)
  total                         Decimal @db.Decimal(14, 2)
  requiresDiscountAuthorization Boolean @default(false)
  discountAuthorizationId       String?

  @@map("sale_items")
}

model SaleWithholding {
  id                   String             @id @default(uuid())
  saleId               String
  sale                 Sale               @relation(fields: [saleId], references: [id])
  withholdingConceptId String
  withholdingConcept   WithholdingConcept @relation(fields: [withholdingConceptId], references: [id])
  base                 Decimal            @db.Decimal(14, 2)
  ratePercent          Decimal            @db.Decimal(5, 2) // snapshot del concepto al aplicarse
  amount               Decimal            @db.Decimal(14, 2)

  @@map("sale_withholdings")
}

model SalePayment {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  method    String  // CASH, CARD, TRANSFER, CREDIT, MIXED
  amount    Decimal @db.Decimal(14, 2)
  reference String?

  @@map("sale_payments")
}

model Quote {
  id           String   @id @default(uuid())
  companyId    String
  branchId     String
  customerId   String?
  sellerUserId String
  status       String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, EXPIRED, CONVERTED
  validUntil   DateTime
  subtotal     Decimal  @db.Decimal(14, 2)
  total        Decimal  @db.Decimal(14, 2)
  // Lista de precios efectiva usada al cotizar (item 35 de docs/ALCANCE.md) -- informativa, mismo
  // criterio que Sale.priceListId. Null = precio base.
  priceListId  String?
  createdAt    DateTime @default(now())

  items QuoteItem[]

  @@index([companyId, branchId])
  @@map("quotes")
}

model QuoteItem {
  id              String  @id @default(uuid())
  quoteId         String
  quote           Quote   @relation(fields: [quoteId], references: [id])
  productId       String
  quantity        Decimal @db.Decimal(14, 4)
  unitPrice       Decimal @db.Decimal(14, 4)
  discountPercent Decimal @db.Decimal(5, 2) @default(0)
  total           Decimal @db.Decimal(14, 2)

  @@map("quote_items")
}

model Order {
  id           String    @id @default(uuid())
  companyId    String
  branchId     String
  customerId   String?
  status       String    @default("PENDING") // PENDING, CONFIRMED, DELIVERED, CANCELLED
  deliveryDate DateTime?
  total        Decimal   @db.Decimal(14, 2)
  createdAt    DateTime  @default(now())

  items OrderItem[]

  @@index([companyId, branchId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  quantity  Decimal @db.Decimal(14, 4)
  unitPrice Decimal @db.Decimal(14, 4)
  total     Decimal @db.Decimal(14, 2)

  @@map("order_items")
}

model Return {
  id              String   @id @default(uuid())
  companyId       String
  branchId        String
  saleId          String
  customerId      String?
  reason          String
  status          String   @default("PENDING")
  total           Decimal  @db.Decimal(14, 2)
  createdByUserId String
  createdAt       DateTime @default(now())

  items ReturnItem[]

  @@index([companyId, branchId])
  @@map("returns")
}

model ReturnItem {
  id                String  @id @default(uuid())
  returnId          String
  return            Return  @relation(fields: [returnId], references: [id])
  saleItemId        String
  productId         String
  quantity          Decimal @db.Decimal(14, 4)
  unitPrice         Decimal @db.Decimal(14, 4)
  total             Decimal @db.Decimal(14, 2)
  restockedToBranch Boolean @default(true)

  @@map("return_items")
}

model CreditNote {
  id         String   @id @default(uuid())
  companyId  String
  branchId   String
  saleId     String?
  customerId String
  reason     String
  amount     Decimal  @db.Decimal(14, 2)
  status     String   @default("ISSUED")
  createdAt  DateTime @default(now())
  // Preparado para facturacion electronica (DIAN, ver electronic-invoicing.prisma):
  cude       String?
  xmlUrl     String?

  electronicCreditNote ElectronicCreditNote?

  @@index([companyId, branchId])
  @@map("credit_notes")
}

model DebitNote {
  id         String   @id @default(uuid())
  companyId  String
  branchId   String
  customerId String
  saleId     String?
  reason     String
  amount     Decimal  @db.Decimal(14, 2)
  status     String   @default("ISSUED")
  createdAt  DateTime @default(now())
  // Preparado para facturacion electronica (DIAN, ver electronic-invoicing.prisma):
  cude       String?
  xmlUrl     String?

  electronicDebitNote ElectronicDebitNote?

  @@index([companyId, branchId])
  @@map("debit_notes")
}

model Layaway {
  id          String   @id @default(uuid())
  companyId   String
  branchId    String
  customerId  String
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  totalAmount Decimal  @db.Decimal(14, 2)
  paidAmount  Decimal  @db.Decimal(14, 2) @default(0)
  dueDate     DateTime
  createdAt   DateTime @default(now())

  items    LayawayItem[]
  payments LayawayPayment[]

  @@index([companyId, branchId])
  @@map("layaways")
}

model LayawayItem {
  id        String  @id @default(uuid())
  layawayId String
  layaway   Layaway @relation(fields: [layawayId], references: [id])
  productId String
  quantity  Decimal @db.Decimal(14, 4)
  unitPrice Decimal @db.Decimal(14, 4)

  @@map("layaway_items")
}

model LayawayPayment {
  id        String   @id @default(uuid())
  layawayId String
  layaway   Layaway  @relation(fields: [layawayId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  paidAt    DateTime @default(now())

  @@map("layaway_payments")
}
