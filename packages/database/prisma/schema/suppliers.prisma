// Proveedores / Compras (STUB en la iteracion 1: modelo completo, sin logica de negocio todavia)
// Ver apps/api/src/modules/suppliers/README.md

model Supplier {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  nit         String
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  // false = proveedor no obligado a facturar electronicamente (persona natural, vendedor
  // informal) -- cada compra registrada contra el genera un documento soporte electronico
  // (ver electronic-invoicing.prisma). Default true = proveedor formal/registrado, el caso
  // comun, para que proveedores existentes no generen documentos soporte sin marcarlo.
  isObligatedToInvoice Boolean @default(true)
  // Item 37 de docs/ALCANCE.md (informacion exogena DIAN): tipo de documento del tercero
  // (NIT/CC/CE). Default "NIT" -- la mayoria de proveedores son personas juridicas, y hasta
  // ahora se asumia NIT implicitamente en todo el modulo (ver electronic-invoicing/README.md).
  documentType String @default("NIT")
  // Codigo DANE de municipio del tercero (5 digitos, los primeros 2 codifican el departamento),
  // mismo campo/criterio que Company.municipalityCode (nomina electronica). Nullable: opcional,
  // terceros existentes no lo tienen.
  municipalityCode String?

  @@unique([companyId, nit])
  @@index([companyId])
  @@map("suppliers")
}

model PurchaseOrder {
  id                String    @id @default(uuid())
  companyId         String
  branchId          String
  supplierId        String
  status            String    @default("DRAFT") // DRAFT, SENT, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  expectedDate      DateTime?
  total             Decimal   @db.Decimal(14, 2)
  createdByUserId   String
  createdAt         DateTime  @default(now())

  items PurchaseOrderItem[]

  @@index([companyId, branchId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  quantity        Decimal       @db.Decimal(14, 4)
  unitCost        Decimal       @db.Decimal(14, 4)
  total           Decimal       @db.Decimal(14, 2)

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id               String   @id @default(uuid())
  companyId        String
  branchId         String
  purchaseOrderId  String?
  supplierId       String
  receivedByUserId String
  createdAt        DateTime @default(now())

  items GoodsReceiptItem[]

  @@index([companyId, branchId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String       @id @default(uuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  productId      String
  quantity       Decimal      @db.Decimal(14, 4)
  unitCost       Decimal      @db.Decimal(14, 4)
  batchNumber    String?
  expirationDate DateTime?

  @@map("goods_receipt_items")
}

model Purchase {
  id            String   @id @default(uuid())
  companyId     String
  branchId      String
  supplierId    String
  invoiceNumber String
  subtotal      Decimal  @db.Decimal(14, 2)
  taxTotal      Decimal  @db.Decimal(14, 2) @default(0)
  total         Decimal  @db.Decimal(14, 2)
  // Multi-moneda informativa (item 33 de docs/ALCANCE.md): el comprobante contable y el
  // documento soporte electronico siempre quedan en COP sin importar estos dos campos -- son
  // solo para mostrar un total de referencia en otra moneda. `exchangeRate` es la TRM capturada
  // manualmente al momento de la compra (COP por 1 unidad de `currency`), sin fetch automatico.
  currency      String   @default("COP") // ISO 4217, 3 letras
  exchangeRate  Decimal  @db.Decimal(14, 4) @default(1)
  // Suma de retenciones practicadas a este proveedor (RteFuente/ReteICA/ReteIVA, ver
  // PurchaseWithholding). No reduce `total` (el bruto legal de la factura del proveedor) -- se
  // descuenta del AccountPayable generado (ver prisma-purchase.repository.ts), que queda neto de
  // retencion desde su creacion.
  retentionTotal Decimal @db.Decimal(14, 2) @default(0)
  status        String   @default("REGISTERED") // REGISTERED, CANCELLED
  createdAt     DateTime @default(now())
  // Preparado para documento soporte electronico (DIAN, ver electronic-invoicing.prisma):
  cuds          String?
  xmlUrl        String?
  // Id del JournalEntry que la contabilizo (ver post-purchase-journal-entry.use-case.ts) -- se
  // guarda para poder anularlo via VoidJournalEntryUseCase si la compra se cancela
  // (CancelPurchaseUseCase, suppliers). Null si la contabilizacion fallo o no dejo comprobante
  // (total = 0).
  journalEntryId String?

  accountsPayable AccountPayable[]
  withholdings    PurchaseWithholding[]
  electronicSupportDocument ElectronicSupportDocument?

  @@index([companyId, branchId])
  @@map("purchases")
}

model PurchaseWithholding {
  id                   String             @id @default(uuid())
  purchaseId           String
  purchase             Purchase           @relation(fields: [purchaseId], references: [id])
  withholdingConceptId String
  withholdingConcept   WithholdingConcept @relation(fields: [withholdingConceptId], references: [id])
  base                 Decimal            @db.Decimal(14, 2)
  ratePercent          Decimal            @db.Decimal(5, 2) // snapshot del concepto al aplicarse
  amount               Decimal            @db.Decimal(14, 2)

  @@map("purchase_withholdings")
}

model AccountPayable {
  id         String   @id @default(uuid())
  companyId  String
  supplierId String
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  balance    Decimal  @db.Decimal(14, 2)
  dueDate    DateTime
  status     String   @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE, CANCELLED

  payments SupplierPayment[]

  @@index([companyId])
  @@map("accounts_payable")
}

model SupplierPayment {
  id               String         @id @default(uuid())
  accountPayableId String
  accountPayable   AccountPayable @relation(fields: [accountPayableId], references: [id])
  amount           Decimal        @db.Decimal(14, 2)
  method           String
  status           String         @default("REGISTERED") // REGISTERED, REVERSED
  paidAt           DateTime       @default(now())
  createdByUserId  String

  @@map("supplier_payments")
}
