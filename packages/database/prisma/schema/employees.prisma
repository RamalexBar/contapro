// Empleados (STUB en la iteracion 1: modelo completo, sin logica de negocio todavia)
// Ver apps/api/src/modules/employees/README.md

model Employee {
  id                String    @id @default(uuid())
  companyId         String
  branchId          String
  userId            String?   @unique
  user              User?     @relation(fields: [userId], references: [id])
  documentType      String
  documentNumber    String
  firstName         String
  lastName          String
  birthDate         DateTime?
  address           String?
  phone             String?
  email             String?
  position          String
  contractType      String    // FIXED_TERM, INDEFINITE, SERVICE, LEARNING
  baseSalary        Decimal   @db.Decimal(14, 2)
  hireDate          DateTime
  terminationDate   DateTime?
  status            String    @default("ACTIVE") // ACTIVE, INACTIVE, ON_LEAVE
  eps               String?
  arlRiskLevel      String?   // I, II, III, IV, V
  pensionFund       String?
  compensationFund  String?
  bankName          String?
  bankAccountNumber String?
  createdAt         DateTime  @default(now())
  // Preparado para nomina electronica DIAN (ver electronic-invoicing.prisma). Valores por
  // defecto de workerType/workerSubtype SIN VERIFICAR contra el Anexo Tecnico -- ver README.
  middleName        String? // segundo nombre / otros nombres
  secondLastName    String? // segundo apellido
  workerType        String  @default("01") // tipo de trabajador DIAN
  workerSubtype     String  @default("00") // subtipo trabajador DIAN
  // Salario integral (art. 132 CST): minimo 13 SMMLV, aportes sobre el 70%, sin cesantias ni prima.
  salaryType        String  @default("ORDINARY") // ORDINARY, INTEGRAL
  // Soportes que el trabajador certifica para la retencion en la fuente (art. 387 E.T. y 126-1/126-4),
  // valores MENSUALES. Los topes legales los aplica payroll-calculator.ts.
  withholdingDependents       Boolean @default(false)
  withholdingHousingInterest  Decimal @default(0) @db.Decimal(14, 2)
  withholdingPrepaidHealth    Decimal @default(0) @db.Decimal(14, 2)
  withholdingVoluntaryPension Decimal @default(0) @db.Decimal(14, 2) // aportes voluntarios a pension, AFC o AVC

  timeEntries       TimeEntry[]
  vacations         Vacation[]
  leaves            LeavePermission[]
  absences          Absence[]
  sickLeaves        SickLeave[]
  payrollDetails    PayrollDetail[]
  payrollDeductions PayrollDeduction[]

  @@unique([companyId, documentNumber])
  @@index([companyId, branchId])
  @@map("employees")
}
