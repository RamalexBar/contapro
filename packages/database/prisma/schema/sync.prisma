// Sincronizacion offline (STUB en la iteracion 1: patron outbox, sin motor de sync todavia)
// Ver apps/api/src/modules/sync/README.md y apps/mobile/src/lib/local-db

model SyncDevice {
  id               String    @id @default(uuid())
  companyId        String
  branchId         String
  userId           String
  deviceIdentifier String
  platform         String    // ANDROID, IOS, WEB
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([companyId, deviceIdentifier])
  @@map("sync_devices")
}

model SyncOutbox {
  id             String    @id @default(uuid())
  companyId      String
  branchId       String
  // Id generado por el cliente al encolar el evento localmente (ver apps/mobile/src/lib/sync) --
  // clave de idempotencia: reenviar el mismo push (ej. la respuesta anterior se perdio por la
  // red) no debe crear un segundo Sale. Unico por empresa, no globalmente (dos empresas podrian
  // generar el mismo uuid en teoria, aunque es astronomicamente improbable).
  clientEventId  String
  entityType     String    // "Sale", "CashMovement", "StockMovement", ...
  entityId       String?   // null hasta que el evento se procese con exito (PENDING/ERROR)
  operation      String    // CREATE, UPDATE, DELETE
  payload        Json
  originDeviceId String?
  status         String    @default("PENDING") // PENDING, SYNCED, CONFLICT, ERROR
  errorMessage   String?
  createdAt      DateTime  @default(now())
  syncedAt       DateTime?

  @@unique([companyId, clientEventId])
  @@index([companyId, status])
  @@map("sync_outbox")
}

model SyncConflictLog {
  id               String    @id @default(uuid())
  outboxEventId    String
  conflictReason   String
  resolution       String?   // SERVER_WINS, CLIENT_WINS, MANUAL
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@map("sync_conflict_logs")
}
