// Clientes: estado de cuenta, creditos, abonos, limite de credito

model Customer {
  id             String   @id @default(uuid())
  companyId      String
  documentType   String   // CC, NIT, CE, PASSPORT
  documentNumber String
  name           String
  email          String?
  phone          String?
  address        String?
  creditLimit    Decimal  @db.Decimal(14, 2) @default(0)
  currentBalance Decimal  @db.Decimal(14, 2) @default(0)
  isActive       Boolean  @default(true)
  // Lista de precios asignada (item 35 de docs/ALCANCE.md) -- si es null, las ventas/cotizaciones
  // a este cliente usan el precio base del producto (Product.currentPrice), salvo que se fuerce
  // otra lista explicitamente en el request. Sin relacion de Prisma declarada, mismo criterio que
  // el resto de referencias cruzadas de este modulo (ej. Sale.customerId).
  priceListId    String?
  // Item 37 de docs/ALCANCE.md (informacion exogena DIAN): codigo DANE de municipio del tercero,
  // mismo campo/criterio que Company.municipalityCode y Supplier.municipalityCode. Nullable.
  municipalityCode String?
  // ---- Catalogos del proveedor tecnologico DIAN (ver modules/electronic-invoicing/README.md,
  // seccion "Proveedor tecnologico (MATIAS API)") -- NO son codigos DIAN oficiales, son los ids
  // internos del catalogo de MATIAS (persona natural/juridica, regimen IVA, nivel de tributacion,
  // pais/ciudad, tipo de documento de identidad). Deliberadamente sin mapear/adivinar desde
  // documentType: el catalogo real de MATIAS solo se confirmo para "CC" (identityDocumentId "1"),
  // el resto se deja para que el contador de cada empresa lo complete con el valor real de
  // MATIAS -- inventar un mapeo aqui arriesgaria enviar datos tributarios incorrectos a la DIAN.
  // Todos opcionales: sin ellos, facturar via proveedor devuelve REJECTED con el motivo real que
  // de MATIAS (mismo criterio no bloqueante que el resto del modulo), la venta se completa igual.
  dianIdentityDocumentId String?
  dianTypeOrganizationId String?
  dianTaxRegimeId        String?
  dianTaxLevelId         String?
  dianCountryId          String?
  dianCityId             String?
  dianPostalCode         String?
  createdAt      DateTime @default(now())

  creditMovements CustomerCreditMovement[]
  payments        CustomerPayment[]

  @@unique([companyId, documentNumber])
  @@index([companyId])
  @@map("customers")
}

model CustomerCreditMovement {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  type          String   // CHARGE, PAYMENT, ADJUSTMENT
  amount        Decimal  @db.Decimal(14, 2)
  referenceType String?
  referenceId   String?
  balanceAfter  Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  @@index([customerId])
  @@map("customer_credit_movements")
}

model CustomerPayment {
  id              String   @id @default(uuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  amount          Decimal  @db.Decimal(14, 2)
  method          String
  saleId          String?
  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([customerId])
  @@map("customer_payments")
}
