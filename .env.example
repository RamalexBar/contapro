# ---- Base de datos ----
DATABASE_URL="postgresql://erp:erp@localhost:5432/erp_saas?schema=public"

# ---- API ----
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
# Secreto SEPARADO del de usuarios de empresa -- requerido (sin default), la API no arranca sin
# esto. Ver apps/api/src/modules/saas-admin/README.md.
JWT_PLATFORM_ADMIN_SECRET="change-me-platform-admin-secret"
JWT_PLATFORM_ADMIN_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:5173"

# ---- Supabase Storage (preparado, no usado aun en la iteracion 1) ----
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="erp-assets"

# ---- Facturacion electronica DIAN (preparado, ver modules/electronic-invoicing/README.md) ----
# Vacios por defecto: sin estos valores (asignados por la DIAN al registrar el software durante
# la habilitacion) el envio real a la DIAN queda deshabilitado, pero el CUFE/XML se generan igual
# localmente para revision/pruebas. Para probar la firma XAdES con un certificado de prueba, ver
# "Como probar localmente sin credenciales DIAN" en ese README (certs/test-cert.p12, gitignored).
DIAN_ENVIRONMENT="HABILITACION"
DIAN_SOFTWARE_ID=""
DIAN_SOFTWARE_PIN=""
DIAN_TECHNICAL_KEY=""
DIAN_CERTIFICATE_PATH=""
DIAN_CERTIFICATE_PASSWORD=""
DIAN_SOAP_ENDPOINT=""
DIAN_NOMINA_SOAP_ENDPOINT=""

# ---- Recordatorios de vencimiento de suscripcion (preparado, ver modules/saas-admin/README.md) ----
# Vacio por defecto: sin RESEND_API_KEY el envio real queda deshabilitado (se reintenta en el
# siguiente ciclo del poller), mismo criterio que las variables DIAN_* de arriba.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@erp-saas.demo"

# ---- Lectura automatica de facturas de compra con IA (ver modules/suppliers/README.md) ----
# Vacio por defecto: sin ANTHROPIC_API_KEY, POST /purchases/extract responde con un mensaje claro
# en vez de fallar en silencio (mismo criterio que RESEND_API_KEY/DIAN_* de arriba). Conseguir una
# llave en console.anthropic.com -- nunca se usa para nada mas que leer la imagen/PDF que el
# propio usuario sube, el registro de la compra lo sigue confirmando el usuario a mano.
ANTHROPIC_API_KEY=""

# ---- Web ----
VITE_API_BASE_URL="http://localhost:4000/api"
